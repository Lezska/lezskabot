# ============================================
# 1. 先取消可能已有的忽略规则（确保关键目录可被跟踪）
#    如果原来有规则忽略了这些目录，! 会强制将它们重新包含
# ============================================
!AstrBot/
!AstrBot/data/
!*.sh
!koishi/
!*.zip
!onebotfilter/
!llone/

# ============================================
# 2. 在需要跟踪的目录内，精确排除不需要的子内容
# ============================================

# --- AstrBot/data/ 下排除临时目录和数据库临时文件 ---
AstrBot/data/**/temp/
AstrBot/data/temp_images/
AstrBot/data/**/tmp/
AstrBot/data/**/cache/
# 所有 .db-shm 和 .db-wal 文件（即使在子目录中）
AstrBot/data/**/*.db-shm
AstrBot/data/**/*.db-wal

# --- koishi/ 下排除所有 node_modules 和其他目录---
koishi/**/node_modules/
koishi/koishi-app/data/logs/
koishi/koishi-app/data/menu/cache/
koishi/**/docker/

# --- 全局排除其他常见的垃圾文件（可选，防止未来误添加） ---
*.db-shm
*.db-wal

# --- cards/ 目录特殊处理 ---
# pjskcards/ - 部署时由 build.sh 拉取, 图片文件不进 git (避免误 add 1213 PNG ≈ 3.8G)
# 真正部署时由 build.sh: git clone ... pjskcards.git && rm -rf pjskcards/.git
pjskcards/
# 兼容旧目录名 (如有遗留的 cards/ 也忽略, 避免误 add)
cards/
# --- Secrets: NEVER commit these. Even though koishi/koishi-app/.env
#     was committed in the initial LFS commit 5ca530b, future commits
#     must not include it. The file is also untracked via `git rm --cached`
#     so .gitignore actually takes effect.
#     See README "安全" section for the secret-rotation checklist.
koishi/koishi-app/.env
koishi/koishi-app/data/random-answer/llm-config.json
llone/bin/llbot/data/config_*.json
llone/bin/llbot/data/accounts.json
llone/bin/llbot/data/llbot.json

# Note: cards/ has LFS rules above (line 37). Other plugin-level secrets
# (e.g. plugin_data/<plugin>/*.json with auth tokens) should also be added
# here on a per-plugin basis. Be conservative.
